{
  "name": "dsh-plugin-buzz",
  "version": "0.4.0",
  "description": "Let dsh agents read and post in Buzz, and put dsh models in Buzz as their own users that answer at once (live relay connection, no polling).",
  "keywords": [
    "agents",
    "buzz",
    "chat",
    "deepseek-harness",
    "dsh",
    "mcp",
    "nostr",
    "push",
    "websocket"
  ],
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "buzz-mcp": "./buzz-mcp.mjs"
  },
  "files": [
    "index.js",
    "buzz-mcp.mjs",
    "listen.mjs",
    "agent-turn.mjs",
    "media.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "requests.mjs",
    "request-transport.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
